# Copie este arquivo para .env e preencha com os valores reais.

# Banco PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mupi

# Chave para assinar os tokens JWT (gere com: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=MUPI <nao-responda@seudominio.com>

# Roteamento a pé (OpenRouteService)
OPENROUTESERVICE_API_KEY=

# Painel administrativo (opcional). Padrão: true (cookie de sessão só por HTTPS;
# funciona em http://localhost). Use false apenas se acessar o painel por outro
# endereço sem HTTPS durante o desenvolvimento.
# ADMIN_COOKIE_SECURE=true

# Sites que podem chamar a API pelo navegador (opcional; vazio = nenhum).
# O app de celular e o painel não precisam disto. Nunca use "*".
# Lista separada por vírgulas, com protocolo e sem barra no final:
# CORS_ALLOWED_ORIGINS=https://painel.mupi.com.br
#
# Desenvolvimento com o app no Chrome (Flutter web muda a porta a cada execução):
# CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Arquivos no Amazon S3 (fotos dos pontos, imagens das insígnias, áudios).
# Bucket privado; o app recebe links temporários assinados.
# Sem S3_BUCKET o servidor sobe, mas o painel não aceita envio de arquivos.
S3_BUCKET=
AWS_REGION=sa-east-1
# Chaves do usuário IAM da aplicação, com permissão só neste bucket
# (s3:PutObject, s3:GetObject, s3:DeleteObject).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional, só no desenvolvimento com S3 local (ex.: MinIO): http://localhost:9000
# S3_ENDPOINT_URL=
