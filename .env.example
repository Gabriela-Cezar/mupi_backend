# Copie este arquivo para .env e preencha com os valores reais.

# Banco PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mupi

# Chave para assinar os tokens JWT (gere com: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=MUPI <nao-responda@seudominio.com>

# Roteamento a pé (OpenRouteService)
OPENROUTESERVICE_API_KEY=

# Painel administrativo (opcional). Padrão: true (cookie de sessão só por HTTPS;
# funciona em http://localhost). Use false apenas se acessar o painel por outro
# endereço sem HTTPS durante o desenvolvimento.
# ADMIN_COOKIE_SECURE=true
